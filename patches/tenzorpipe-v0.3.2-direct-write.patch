+def _engine_binary_version():
+    """The release version of the committed engine binary, or None if it will not run."""
+    try:
+        out = subprocess.run([str(ENGINE), "--version"], capture_output=True, text=True, check=True)
+    except (OSError, subprocess.CalledProcessError):
+        return None
+    return out.stdout.strip().split()[-1]
+
+
+def _normalise_version(blob: bytes, source: str, target: str) -> bytes:
+    """Rewrite the embedded engine version so artifacts from two releases can be compared.
+
+    Every artifact carries the engine version twice in its Arrow `origin` metadata, once per
+    footer copy, so a version bump alone changes two bytes in an otherwise identical file.
+    The identity matrix in scripts/test_skip_identity.py does the same substitution for the
+    same reason; the occurrence count is asserted so this can never silently mask a real
+    difference elsewhere in the file.
+    """
+    source_b, target_b = source.encode(), target.encode()
+    assert len(source_b) == len(target_b), f"version lengths differ: {source} vs {target}"
+    count = blob.count(source_b)
+    assert count == 2, f"expected 2 embedded version strings, found {count}"
+    return blob.replace(source_b, target_b)
+
+
