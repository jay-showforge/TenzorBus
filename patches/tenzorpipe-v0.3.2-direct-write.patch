index 0000000..cd614d7
--- /dev/null
+++ b/src/sink.rs
@@ -0,0 +1,77 @@
+//! Where a converted epoch's video tensor goes.
+//!
+//! The engine's default destination is the `.tenzor` writer, and that path is
+//! untouched: [`crate::cli::convert`] behaves exactly as it always has. This
+//! module adds a second, opt-in destination so a cooperating consumer — a live
+//! transport such as TenzorBus — can receive each epoch's tensor without a file
+//! in the middle, and can optionally supply the buffer the decoder writes into,
+//! which removes the copy entirely.
+//!
+//! The handshake is an offer, not a demand, in both directions:
+//!
+//! * The engine offers a destination only where it can — one picture at a time,
+//!   in presentation order, with exactly one epoch to serve. That is the
+//!   sequential single-decoder H.264 path. The chunked parallel decoder and the
+//!   concurrent executor buffer owned tensors by design, so no destination is
+//!   offered there.
+//! * The sink may decline by returning `None`, and is then handed the tensor.
+//!
+//! A sink that took a destination and never saw [`EpochSink::epoch_ready`] for
+//! that epoch must treat the buffer as abandoned; [`EpochSink::abort_epoch`] is
+//! called when the engine knows it failed, but a sink should also release the
+//! buffer on drop, because a panic can skip the call.
+
+use anyhow::{Context, Result};
+
+/// A destination for per-epoch video tensors.
+pub trait EpochSink {
+    /// Offer to write epoch `epoch`'s tensor straight into a buffer the sink
+    /// owns. Return `Some(buf)`, exactly `len` floats long, to accept; return
+    /// `None` to be handed the tensor by [`EpochSink::epoch_ready`] instead.
+    ///
+    /// The default declines, which is what keeps every existing caller — and
+    /// the `.tenzor` writer — on exactly the behaviour they had before.
+    fn video_destination(
+        &mut self,
+        _epoch: usize,
+        _pts: i64,
+        _len: usize,
+    ) -> Result<Option<&mut [f32]>> {
+        Ok(None)
+    }
+
+    /// Epoch `epoch` is complete. `tensor` is `Some` when the engine produced it
+    /// itself, and `None` when the sink accepted a destination and the decoder
+    /// has already filled it.
+    fn epoch_ready(&mut self, epoch: usize, pts: i64, tensor: Option<&[f32]>) -> Result<()>;
+
+    /// The engine failed after this sink accepted a destination for `epoch`.
+    fn abort_epoch(&mut self, _epoch: usize) {}
+}
+
+/// Every `FnMut(epoch, pts, &[f32])` is a sink that never takes a destination.
+///
+/// This is what lets the decoders keep their existing closure-based callers
+/// compiling untouched while the engine talks to a trait internally.
+impl<F> EpochSink for F
+where
+    F: FnMut(usize, i64, &[f32]) -> Result<()>,
+{
+    fn epoch_ready(&mut self, epoch: usize, pts: i64, tensor: Option<&[f32]>) -> Result<()> {
+        let tensor = tensor.context(
+            "a closure sink was handed an epoch with no tensor, but closure sinks never \
+             accept a destination",
+        )?;
+        self(epoch, pts, tensor)
+    }
+}
+
+/// Discards every epoch. `convert` uses this so the file path runs the same code
+/// as `convert_with_sink` without a sink ever being consulted.
+pub struct NullSink;
+
+impl EpochSink for NullSink {
+    fn epoch_ready(&mut self, _epoch: usize, _pts: i64, _tensor: Option<&[f32]>) -> Result<()> {
+        Ok(())
+    }
+}
