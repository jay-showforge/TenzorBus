+def _engine_binary_version():
+    """The release version of the committed engine binary, or None if it will not run."""
+    try:
+        out = subprocess.run([str(ENGINE), "--version"], capture_output=True, text=True, check=True)
+    except (OSError, subprocess.CalledProcessError):
+        return None
+    return out.stdout.strip().split()[-1]
+
+
+def _normalise_version(blob: bytes, source: str, target: str) -> bytes:
+    """Rewrite the embedded engine version so artifacts from two releases can be compared.
+
+    Every artifact carries the engine version twice in its Arrow `origin` metadata, once per
+    footer copy, so a version bump alone changes two bytes in an otherwise identical file.
+    The identity matrix in scripts/test_skip_identity.py does the same substitution for the
+    same reason; the occurrence count is asserted so this can never silently mask a real
+    difference elsewhere in the file.
+    """
+    source_b, target_b = source.encode(), target.encode()
+    assert len(source_b) == len(target_b), f"version lengths differ: {source} vs {target}"
+    count = blob.count(source_b)
+    assert count == 2, f"expected 2 embedded version strings, found {count}"
+    return blob.replace(source_b, target_b)
+
+
 @pytest.mark.skipif(not ENGINE.exists(), reason="bin/tenzor-linux-x86_64 not present")
 def test_python_output_matches_the_engine_binary(clip, tmp_path):
+    binary_version = _engine_binary_version()
+    if binary_version is None:
+        pytest.skip("bin/tenzor-linux-x86_64 is not executable in this checkout")
+
     from_python, from_binary = tmp_path / "py.tenzor", tmp_path / "bin.tenzor"
     tp.ingest(clip, from_python, video_workers=2)
     subprocess.run([str(ENGINE), "-i", str(clip), "-o", str(from_binary), "--video-workers", "2", "--quiet"],
                    check=True)
-    assert from_python.read_bytes() == from_binary.read_bytes()
+
+    produced, reference = from_python.read_bytes(), from_binary.read_bytes()
+    if binary_version != tp.__version__:
+        # The committed binary is an earlier release than this source tree. Comparing the
+        # tensors is still the point of this test, so normalise the one field that a version
+        # bump is *supposed* to change and require every other byte to match.
+        produced = _normalise_version(produced, tp.__version__, binary_version)
+    assert produced == reference
 
 
