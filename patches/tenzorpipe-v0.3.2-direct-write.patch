+#!/usr/bin/env python3
+"""Prove the `.tenzor` path is byte-identical after the EpochSink refactor.
+
+The refactor split the resize into an `_into` form plus an allocating wrapper and
+moved the decoders onto a trait. Neither is supposed to change a single output
+byte, so this compares artifacts from a pristine build against artifacts from the
+refactored build across a matrix of settings and decoder variants. Both are the
+same engine version, so the comparison is exact: no version normalisation, no
+tolerance.
+
+    OLD=/path/to/pristine/target/release/tenzor \\
+    NEW=/path/to/refactored/target/release/tenzor \\
+    python3 scripts/test_sink_refactor_identity.py
+
+Exits non-zero on the first mismatch and prints which case and which byte.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+OLD = os.environ.get("OLD", str(ROOT.parent / "tenzorpipe-pristine/target/release/tenzor"))
+NEW = os.environ.get("NEW", str(ROOT / "target/release/tenzor"))
+
+# Settings chosen to exercise the code the refactor touched: the single-decoder
+# path (where a destination would now be offered), the chunked parallel path, and
+# the repeated-epoch case where one picture serves several epochs.
+SETTINGS = [
+    ("default", []),
+    ("res160-win033-batch2", ["--resolution", "160", "--window-sec", "0.33", "--batch-epochs", "2"]),
+    ("win005-batch7", ["--window-sec", "0.05", "--batch-epochs", "7"]),
+    ("sequential-win1", ["--execution", "sequential", "--window-sec", "1.0"]),
+    # One picture serving several epochs: a long window over a 30 fps clip.
+    ("repeated-epochs-win2", ["--window-sec", "2.0"]),
+    ("res64", ["--resolution", "64"]),
+]
+VARIANTS = [
+    ("w1", ["--video-workers", "1"]),
+    ("w2-chunk250", ["--video-workers", "2", "--chunk-target-ms", "250"]),
+    ("w4", ["--video-workers", "4"]),
+    ("w1-noskip", ["--video-workers", "1", "--no-skip-nonref"]),
+    ("w1-seq", ["--video-workers", "1", "--execution", "sequential"]),
+]
+
+
+def fixtures(tmp: pathlib.Path) -> list[pathlib.Path]:
+    """Real H.264/AAC clips: one short, one longer with a 2 s GOP and B-frames."""
+    specs = [
+        ("short", "320x240", 30, 3, 30),
+        ("gop", "640x360", 30, 6, 60),
+    ]
+    out = []
+    for name, size, rate, secs, gop in specs:
+        path = tmp / f"{name}.mp4"
+        subprocess.run(
+            [
+                "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
+                "-f", "lavfi", "-i", f"testsrc2=size={size}:rate={rate}:duration={secs}",
+                "-f", "lavfi", "-i", f"sine=frequency=440:sample_rate=48000:duration={secs}",
+                "-c:v", "libx264", "-pix_fmt", "yuv420p", "-g", str(gop), "-bf", "2",
+                "-c:a", "aac", "-shortest", str(path),
+            ],
+            check=True,
+        )
+        out.append(path)
+    return out
+
+
+def run(binary: str, media: pathlib.Path, out: pathlib.Path, args: list[str]):
+    out.unlink(missing_ok=True)
+    proc = subprocess.run(
+        [binary, "-i", str(media), "-o", str(out), "--quiet", *args],
+        capture_output=True, text=True, timeout=900,
+    )
+    if proc.returncode != 0:
+        return None, proc.stderr.strip().splitlines()[-1] if proc.stderr.strip() else "failed"
+    return out.read_bytes(), None
+
+
+def main() -> int:
+    for label, binary in (("OLD", OLD), ("NEW", NEW)):
+        if not pathlib.Path(binary).exists():
+            print(f"{label} binary not found: {binary}", file=sys.stderr)
+            return 2
+    results = {"cases": 0, "identical": 0, "same_error": 0, "mismatch": 0, "failures": []}
+
+    with tempfile.TemporaryDirectory(prefix="sink-identity-") as td:
+        tmp = pathlib.Path(td)
+        media_files = fixtures(tmp)
+        for media in media_files:
+            for setting_name, setting in SETTINGS:
+                for variant_name, variant in VARIANTS:
+                    case = f"{media.stem}/{setting_name}/{variant_name}"
+                    results["cases"] += 1
+                    old_bytes, old_err = run(OLD, media, tmp / "old.tenzor", setting + variant)
+                    new_bytes, new_err = run(NEW, media, tmp / "new.tenzor", setting + variant)
+
+                    if old_err or new_err:
+                        # A configuration the engine rejects must be rejected the
+                        # same way by both builds.
+                        if old_err and new_err and old_err == new_err:
+                            results["same_error"] += 1
+                            continue
+                        results["mismatch"] += 1
+                        results["failures"].append(
+                            {"case": case, "old_error": old_err, "new_error": new_err}
+                        )
+                        print(f"MISMATCH {case}: old_err={old_err!r} new_err={new_err!r}")
+                        continue
+
+                    if old_bytes == new_bytes:
+                        results["identical"] += 1
+                        continue
+
+                    results["mismatch"] += 1
+                    where = next(
+                        (
+                            i
+                            for i in range(min(len(old_bytes), len(new_bytes)))
+                            if old_bytes[i] != new_bytes[i]
+                        ),
+                        min(len(old_bytes), len(new_bytes)),
+                    )
+                    detail = {
+                        "case": case,
+                        "old_bytes": len(old_bytes),
+                        "new_bytes": len(new_bytes),
+                        "first_difference_at": where,
+                        "old_sha256": hashlib.sha256(old_bytes).hexdigest(),
+                        "new_sha256": hashlib.sha256(new_bytes).hexdigest(),
+                    }
+                    results["failures"].append(detail)
+                    print(f"MISMATCH {case}: {json.dumps(detail)}")
+
+    print(json.dumps(results, indent=2))
+    print(
+        f"\n{results['identical']} identical, {results['same_error']} matching refusals, "
+        f"{results['mismatch']} mismatched, out of {results['cases']} cases"
+    )
+    return 1 if results["mismatch"] else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
