diff --git a/tests/sink_direct_write.rs b/tests/sink_direct_write.rs
new file mode 100644
index 0000000..5e0c914
--- /dev/null
+++ b/tests/sink_direct_write.rs
@@ -0,0 +1,268 @@
+//! `convert_with_sink` acceptance: the sink sees every epoch, and a sink that
+//! supplies destinations receives byte-identical tensors.
+//!
+//! The reference is the engine's own `.tenzor` output for the same clip, read
+//! back with Arrow. That is the only comparison worth making: it asks whether
+//! direct write changes the tensors, and the answer has to be no.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use anyhow::Result;
+use tenzor_pipe::{Cli, EpochSink, convert, convert_with_sink, parse_args};
+
+/// Collects every epoch, optionally offering its own destination buffers so the
+/// decoder writes into them directly.
+struct Collector {
+    resolution: usize,
+    offer_destinations: bool,
+    scratch: Vec<f32>,
+    epochs: Vec<(usize, i64, Vec<f32>)>,
+    destinations_taken: usize,
+    pending: Option<(usize, i64)>,
+}
+
+impl Collector {
+    fn new(resolution: usize, offer_destinations: bool) -> Self {
+        Self {
+            resolution,
+            offer_destinations,
+            scratch: vec![0.0; 3 * resolution * resolution],
+            epochs: Vec::new(),
+            destinations_taken: 0,
+            pending: None,
+        }
+    }
+}
+
+impl EpochSink for Collector {
+    fn video_destination(
+        &mut self,
+        epoch: usize,
+        pts: i64,
+        len: usize,
+    ) -> Result<Option<&mut [f32]>> {
+        if !self.offer_destinations {
+            return Ok(None);
+        }
+        assert_eq!(len, 3 * self.resolution * self.resolution);
+        self.pending = Some((epoch, pts));
+        self.destinations_taken += 1;
+        Ok(Some(&mut self.scratch))
+    }
+
+    fn epoch_ready(&mut self, epoch: usize, pts: i64, tensor: Option<&[f32]>) -> Result<()> {
+        match tensor {
+            Some(values) => self.epochs.push((epoch, pts, values.to_vec())),
+            None => {
+                // The decoder filled the buffer this sink handed out.
+                let (pending_epoch, pending_pts) =
+                    self.pending.take().expect("a destination was taken");
+                assert_eq!(pending_epoch, epoch);
+                assert_eq!(pending_pts, pts);
+                self.epochs.push((epoch, pts, self.scratch.clone()));
+            }
+        }
+        Ok(())
+    }
+
+    fn abort_epoch(&mut self, _epoch: usize) {
+        self.pending = None;
+    }
+}
+
+fn fixture(dir: &Path) -> PathBuf {
+    let path = dir.join("sink.mp4");
+    let status = Command::new("ffmpeg")
+        .args([
+            "-hide_banner",
+            "-loglevel",
+            "error",
+            "-y",
+            "-f",
+            "lavfi",
+            "-i",
+            "testsrc2=size=320x240:rate=30:duration=4",
+            "-f",
+            "lavfi",
+            "-i",
+            "sine=frequency=440:sample_rate=48000:duration=4",
+            "-c:v",
+            "libx264",
+            "-pix_fmt",
+            "yuv420p",
+            "-g",
+            "60",
+            "-bf",
+            "2",
+            "-c:a",
+            "aac",
+            "-shortest",
+        ])
+        .arg(&path)
+        .status()
+        .expect("ffmpeg must be available");
+    assert!(status.success(), "ffmpeg failed to build the fixture");
+    path
+}
+
+fn cli(input: &Path, output: &Path, extra: &[&str]) -> Cli {
+    let mut argv: Vec<String> = vec![
+        "tenzor".into(),
+        "-i".into(),
+        input.display().to_string(),
+        "-o".into(),
+        output.display().to_string(),
+        "--quiet".into(),
+        "--execution".into(),
+        "sequential".into(),
+        "--video-workers".into(),
+        "1".into(),
+    ];
+    argv.extend(extra.iter().map(|s| (*s).to_string()));
+    parse_args(argv).expect("valid arguments")
+}
+
+/// The epochs the `.tenzor` file contains, as the writer recorded them.
+fn tensors_from_file(path: &Path, resolution: usize) -> Vec<Vec<f32>> {
+    use arrow::array::{Array, FixedSizeListArray, Float32Array};
+    let file = std::fs::File::open(path).expect("open .tenzor");
+    let reader = arrow::ipc::reader::FileReader::try_new(file, None).expect("arrow reader");
+    let width = 3 * resolution * resolution;
+    let mut out = Vec::new();
+    for batch in reader {
+        let batch = batch.expect("batch");
+        let column = batch
+            .column_by_name("video_tensor")
+            .expect("video_tensor column");
+        let list = column
+            .as_any()
+            .downcast_ref::<FixedSizeListArray>()
+            .expect("fixed size list");
+        let values = list
+            .values()
+            .as_any()
+            .downcast_ref::<Float32Array>()
+            .expect("f32 values");
+        for row in 0..batch.num_rows() {
+            let start = (list.offset() + row) * width;
+            out.push(values.values()[start..start + width].to_vec());
+        }
+    }
+    out
+}
+
+#[test]
+fn a_destination_taking_sink_gets_the_same_tensors_as_the_file() {
+    let dir = tempdir();
+    let media = fixture(&dir);
+    let resolution = 224;
+
+    // Reference: the ordinary `.tenzor` path, untouched.
+    let file_out = dir.join("reference.tenzor");
+    let summary = convert(&cli(&media, &file_out, &[])).expect("convert");
+    let reference = tensors_from_file(&file_out, resolution);
+    assert_eq!(reference.len(), summary.epochs);
+    assert!(
+        summary.epochs > 1,
+        "fixture produced too few epochs to be a test"
+    );
+
+    // Direct write: the decoder resizes into buffers this sink supplies.
+    let mut direct = Collector::new(resolution, true);
+    let streamed = convert_with_sink(&cli(&media, &dir.join("ignored.tenzor"), &[]), &mut direct)
+        .expect("convert_with_sink");
+
+    assert_eq!(streamed.epochs, summary.epochs);
+    assert_eq!(direct.epochs.len(), summary.epochs);
+    assert_eq!(
+        direct.destinations_taken, summary.epochs,
+        "the engine should have offered a destination for every epoch of this clip"
+    );
+    assert!(
+        !dir.join("ignored.tenzor").exists(),
+        "convert_with_sink must not write a file"
+    );
+
+    for (index, (epoch, _pts, values)) in direct.epochs.iter().enumerate() {
+        assert_eq!(*epoch, index, "epochs must arrive in order");
+        assert_eq!(
+            values, &reference[index],
+            "direct-write tensor for epoch {index} differs from the .tenzor tensor"
+        );
+    }
+
+    // And a sink that declines a destination must get the same tensors too.
+    let mut copied = Collector::new(resolution, false);
+    convert_with_sink(&cli(&media, &dir.join("ignored2.tenzor"), &[]), &mut copied)
+        .expect("convert_with_sink");
+    assert_eq!(copied.destinations_taken, 0);
+    assert_eq!(copied.epochs.len(), summary.epochs);
+    for (index, (_, _, values)) in copied.epochs.iter().enumerate() {
+        assert_eq!(values, &reference[index]);
+    }
+}
+
+#[test]
+fn repeated_epochs_from_one_picture_still_reach_the_sink() {
+    // A long window over a 30 fps clip makes one picture serve several epochs.
+    // The engine cannot offer a destination there, so the sink must still be
+    // handed the tensor -- and every epoch must still arrive.
+    let dir = tempdir();
+    let media = fixture(&dir);
+    let resolution = 64;
+    let extra = ["--window-sec", "2.0", "--resolution", "64"];
+
+    let file_out = dir.join("reference.tenzor");
+    let summary = convert(&cli(&media, &file_out, &extra)).expect("convert");
+    let reference = tensors_from_file(&file_out, resolution);
+
+    let mut sink = Collector::new(resolution, true);
+    let streamed = convert_with_sink(&cli(&media, &dir.join("ignored.tenzor"), &extra), &mut sink)
+        .expect("convert_with_sink");
+
+    assert_eq!(streamed.epochs, summary.epochs);
+    assert_eq!(sink.epochs.len(), summary.epochs);
+    for (index, (epoch, _, values)) in sink.epochs.iter().enumerate() {
+        assert_eq!(*epoch, index);
+        assert_eq!(values, &reference[index]);
+    }
+}
+
+#[test]
+fn the_concurrent_executor_is_refused_rather_than_silently_copying() {
+    let dir = tempdir();
+    let media = fixture(&dir);
+    let mut argv: Vec<String> = vec![
+        "tenzor".into(),
+        "-i".into(),
+        media.display().to_string(),
+        "-o".into(),
+        dir.join("out.tenzor").display().to_string(),
+        "--quiet".into(),
+        "--execution".into(),
+        "concurrent".into(),
+    ];
+    argv.push("--video-workers".into());
+    argv.push("1".into());
+    let args = parse_args(argv).expect("valid arguments");
+    let mut sink = Collector::new(224, true);
+    let error = convert_with_sink(&args, &mut sink).expect_err("must refuse");
+    assert!(
+        error.to_string().contains("--execution sequential"),
+        "the refusal should say what to do instead, got: {error}"
+    );
+}
+
+fn tempdir() -> PathBuf {
+    let base = std::env::temp_dir().join(format!(
+        "tenzor-sink-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    std::fs::create_dir_all(&base).expect("temp dir");
+    base
+}
